{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "argv"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "default": 600
          }
        }
      }
    },
    "limits": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "agent_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1200
        },
        "run_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 5400
        }
      }
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editable_paths",
        "protected_paths"
      ],
      "properties": {
        "editable_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "policy"
        ]
      },
      "else": {
        "not": {
          "required": [
            "policy"
          ]
        }
      }
    }
  ]
}
