{
  "name": "codex-factory",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop-first Codex factory template and optional unattended runner",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "factory": "node --import tsx factory/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:check": "node scripts/build-plugin.mjs --check",
    "plugin:pack": "node scripts/build-plugin.mjs --check --archive",
    "verify:demo": "node --import tsx factory/cli.ts verify --config examples/demo/factory.json",
    "format:check": "prettier --check \"factory/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"plugin-src/scripts/**/*.mjs\""
  },
  "dependencies": {
    "fflate": "0.8.3",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  }
}
